<mxfile host="Claude Code" version="1.0">
  <diagram name="bot-decision-logic">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" parent="1" style="text;html=1;fontSize=23;fontStyle=1;align=left;" value="How a bot decides — engine/src/bots.ts" vertex="1"><mxGeometry x="40" y="30" width="560" height="34" as="geometry"/></mxCell><mxCell id="c3" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#888888;fontStyle=2;" value="Augustine Liu · 2026-08-27" vertex="1"><mxGeometry x="40" y="66" width="240" height="16" as="geometry"/></mxCell><mxCell id="c4" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#888888;fontStyle=2;" value="Intent: the CURRENT per-decision logic, with every tunable weight at its default. Gray dashed = built but switched off. Red = what the logic cannot see. Omits: reducer rules, evolution loop." vertex="1"><mxGeometry x="40" y="84" width="620" height="32" as="geometry"/></mxCell><mxCell id="c5" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#dae8fc;strokeColor=#4472a8;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#333333;" value="&lt;b&gt;SeatView&lt;/b&gt; — all the bot may see&lt;br&gt;&lt;font style=&apos;font-size:10px&apos;&gt;own hand + drawn tile&lt;br&gt;every seat&apos;s discards, melds, flowers&lt;br&gt;others&apos; tile COUNTS (never tiles)&lt;br&gt;wall remaining · last discard&lt;/font&gt;" vertex="1"><mxGeometry x="40" y="150" width="220" height="120" as="geometry"/></mxCell><mxCell id="c6" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#ffffff;strokeColor=#4472a8;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#333333;" value="&lt;b&gt;1 · Pick a plan — chooseRoute()&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:10px&apos;&gt;scores ALL 10 templates from scratch:&lt;br&gt;flush ×3 · half-flush ×3 · all-pungs ·&lt;br&gt;honours · balanced · 13-orphans (gated ≥6 kinds)&lt;/font&gt;" vertex="1"><mxGeometry x="320" y="140" width="270" height="100" as="geometry"/></mxCell><mxCell id="c7" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#fff2cc;strokeColor=#b8860b;strokeWidth=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#333333;" value="route score =&lt;br&gt;&lt;b&gt;faan·0.6&lt;/b&gt; − distance·1.0 − offRoute·1.2&lt;br&gt;− &lt;b&gt;5 if route can&apos;t reach 3 faan&lt;/b&gt;" vertex="1"><mxGeometry x="320" y="250" width="270" height="64" as="geometry"/></mxCell><mxCell id="c8" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#888888;fontStyle=2;" value="re-run on EVERY decision — no memory,&lt;br&gt;no committed plan; pivots are free" vertex="1"><mxGeometry x="320" y="320" width="270" height="30" as="geometry"/></mxCell><mxCell id="c9" parent="1" style="shape=rhombus;html=1;fillColor=#ffffff;strokeColor=#4472a8;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;" value="claim&lt;br&gt;window?" vertex="1"><mxGeometry x="650" y="160" width="110" height="70" as="geometry"/></mxCell><mxCell id="c10" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#ffffff;strokeColor=#4472a8;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#333333;" value="&lt;b&gt;2 · Claim? — assessClaim()&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:10px&apos;&gt;a WIN is always taken (floor-checked by reducer)&lt;br&gt;13-orphans route: refuse every meld&lt;/font&gt;" vertex="1"><mxGeometry x="820" y="60" width="290" height="76" as="geometry"/></mxCell><mxCell id="c11" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#fff2cc;strokeColor=#b8860b;strokeWidth=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#333333;" value="take pung/chow/kong only if:&lt;br&gt;route damage ≤ &lt;b&gt;tolerance 1.6&lt;/b&gt;&lt;br&gt;and speed gain ≥ &lt;b&gt;1.0&lt;/b&gt; · (2 − &lt;b&gt;aggression 1.0&lt;/b&gt;)" vertex="1"><mxGeometry x="820" y="144" width="290" height="60" as="geometry"/></mxCell><mxCell id="c12" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#ffffff;strokeColor=#4472a8;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#333333;" value="&lt;b&gt;3 · Cut a tile — rankDiscards()&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:10px&apos;&gt;win check first (self-draw) · kong check (shouldKong)&lt;br&gt;then every candidate tile is scored:&lt;/font&gt;" vertex="1"><mxGeometry x="820" y="250" width="290" height="74" as="geometry"/></mxCell><mxCell id="c13" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#fff2cc;strokeColor=#b8860b;strokeWidth=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#333333;" value="cut score = −distance·&lt;b&gt;3.0&lt;/b&gt; − routeDist·&lt;b&gt;1.15&lt;/b&gt;·½&lt;br&gt;± routeFit − danger·&lt;b&gt;0.45&lt;/b&gt; − threat·fold·&lt;b&gt;0&lt;/b&gt;&lt;br&gt;+ liveTiles·&lt;b&gt;0.055&lt;/b&gt; (tiebreak only)" vertex="1"><mxGeometry x="820" y="332" width="290" height="64" as="geometry"/></mxCell><mxCell id="c14" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#f5f5f5;strokeColor=#888888;strokeWidth=2;dashed=1;dashPattern=8 4;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#555555;" value="&lt;b&gt;Opponent awareness — threat.ts&lt;/b&gt; (BUILT, &lt;b&gt;OFF&lt;/b&gt;)&lt;br&gt;&lt;font style=&apos;font-size:10px&apos;&gt;per seat: exposure · suit intent · ready-proxy&lt;br&gt;foldFactor = max(0, maxThreat − ownStrength·push)&lt;br&gt;dials default 0 — A/B at 1.4/0.8: did not pay&lt;/font&gt;" vertex="1"><mxGeometry x="820" y="420" width="290" height="86" as="geometry"/></mxCell><mxCell id="c15" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#dae8fc;strokeColor=#4472a8;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Action → reducer&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:10px&apos;&gt;a REQUEST — the table&lt;br&gt;enforces legality + 3-faan floor&lt;/font&gt;" vertex="1"><mxGeometry x="1180" y="190" width="180" height="80" as="geometry"/></mxCell><mxCell id="c16" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#333333;" value="&lt;b&gt;What the logic cannot see&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:10px&apos;&gt;· &lt;b&gt;chips&lt;/b&gt; — faan valued LINEARLY; the exponential payment table is never consulted (6 faan ≈ 8× chips, bot thinks 2×)&lt;br&gt;· &lt;b&gt;opponents, when picking the route&lt;/b&gt; — threat reaches only discard safety, never plan choice&lt;br&gt;· &lt;b&gt;restructuring when ready-under-floor&lt;/b&gt; — camps instead (10 refusals in one logged hand)&lt;br&gt;· left-feed · claim signaling · discard-order bluffing (STRATEGY.md)&lt;/font&gt;" vertex="1"><mxGeometry x="320" y="420" width="470" height="120" as="geometry"/></mxCell><mxCell id="c17" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;html=1;" value="" edge="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;html=1;" value="" edge="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;html=1;dashed=1;strokeWidth=1;strokeColor=#b8860b;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" value="" edge="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;html=1;" value="yes" edge="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;html=1;" value="no — my turn" edge="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;html=1;dashed=1;strokeWidth=1;strokeColor=#b8860b;" value="" edge="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;html=1;dashed=1;strokeWidth=1;strokeColor=#b8860b;" value="" edge="1" source="c13" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;html=1;dashed=1;strokeColor=#888888;" value="only the danger term" edge="1" source="c14" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;html=1;" value="" edge="1" source="c10" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;html=1;" value="" edge="1" source="c12" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#888888;fontStyle=2;" value="&lt;b&gt;legend&lt;/b&gt;  blue = live logic · amber = the 13 evolution-tunable weights (values shown = current defaults) · gray dashed = built, switched off · red = absent" vertex="1"><mxGeometry x="40" y="560" width="760" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
