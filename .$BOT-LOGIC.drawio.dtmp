        </mxCell>
        <mxCell id="c3" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#888888;fontStyle=2;" value="Augustine Liu · 2026-08-27" vertex="1">
          <mxGeometry height="16" width="240" x="40" y="66" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#888888;fontStyle=2;" value="Intent: the CURRENT per-decision logic, with every tunable weight at its default. Gray dashed = built but switched off. Red = what the logic cannot see. Omits: reducer rules, evolution loop." vertex="1">
          <mxGeometry height="32" width="620" x="40" y="84" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#dae8fc;strokeColor=#4472a8;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#333333;" value="&lt;b&gt;SeatView&lt;/b&gt; — all the bot may see&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;own hand + drawn tile&lt;br&gt;every seat&#39;s discards, melds, flowers&lt;br&gt;others&#39; tile COUNTS (never tiles)&lt;br&gt;wall remaining · last discard&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="220" x="40" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#ffffff;strokeColor=#4472a8;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#333333;" value="&lt;b&gt;1 · Pick a plan — chooseRoute()&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;scores ALL 10 templates from scratch:&lt;br&gt;flush ×3 · half-flush ×3 · all-pungs ·&lt;br&gt;honours · balanced · 13-orphans (gated ≥6 kinds)&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="270" x="320" y="140" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#fff2cc;strokeColor=#b8860b;strokeWidth=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#333333;" value="route score =&lt;br&gt;&lt;b&gt;faan·0.6&lt;/b&gt; − distance·1.0 − offRoute·1.2&lt;br&gt;− &lt;b&gt;5 if route can&#39;t reach 3 faan&lt;/b&gt;" vertex="1">
          <mxGeometry height="64" width="270" x="320" y="250" as="geometry" />
        </mxCell>
        <mxCell id="c8" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#888888;fontStyle=2;" value="re-run on EVERY decision — no memory,&lt;br&gt;no committed plan; pivots are free" vertex="1">
          <mxGeometry height="30" width="270" x="320" y="320" as="geometry" />
        </mxCell>
        <mxCell id="c9" parent="1" style="shape=rhombus;html=1;fillColor=#ffffff;strokeColor=#4472a8;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;" value="claim&lt;br&gt;window?" vertex="1">
          <mxGeometry height="70" width="110" x="650" y="160" as="geometry" />
        </mxCell>
        <mxCell id="c10" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#ffffff;strokeColor=#4472a8;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#333333;" value="&lt;b&gt;2 · Claim? — assessClaim()&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;a WIN is always taken (floor-checked by reducer)&lt;br&gt;13-orphans route: refuse every meld&lt;/font&gt;" vertex="1">
          <mxGeometry height="76" width="290" x="820" y="60" as="geometry" />
        </mxCell>
        <mxCell id="c11" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#fff2cc;strokeColor=#b8860b;strokeWidth=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#333333;" value="take pung/chow/kong only if:&lt;br&gt;route damage ≤ &lt;b&gt;tolerance 1.6&lt;/b&gt;&lt;br&gt;and speed gain ≥ &lt;b&gt;1.0&lt;/b&gt; · (2 − &lt;b&gt;aggression 1.0&lt;/b&gt;)" vertex="1">
          <mxGeometry height="60" width="290" x="820" y="144" as="geometry" />
        </mxCell>
        <mxCell id="c12" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#ffffff;strokeColor=#4472a8;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#333333;" value="&lt;b&gt;3 · Cut a tile — rankDiscards()&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;win check first (self-draw) · kong check (shouldKong)&lt;br&gt;then every candidate tile is scored:&lt;/font&gt;" vertex="1">
          <mxGeometry height="74" width="290" x="820" y="250" as="geometry" />
        </mxCell>
        <mxCell id="c13" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#fff2cc;strokeColor=#b8860b;strokeWidth=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#333333;" value="cut score = −distance·&lt;b&gt;3.0&lt;/b&gt; − routeDist·&lt;b&gt;1.15&lt;/b&gt;·½&lt;br&gt;± routeFit − danger·&lt;b&gt;0.45&lt;/b&gt; − threat·fold·&lt;b&gt;0&lt;/b&gt;&lt;br&gt;+ liveTiles·&lt;b&gt;0.055&lt;/b&gt; (tiebreak only)" vertex="1">
          <mxGeometry height="64" width="290" x="820" y="332" as="geometry" />
        </mxCell>
        <mxCell id="c14" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#f5f5f5;strokeColor=#888888;strokeWidth=2;dashed=1;dashPattern=8 4;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#555555;" value="&lt;b&gt;Opponent awareness — threat.ts&lt;/b&gt; (BUILT, &lt;b&gt;OFF&lt;/b&gt;)&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;per seat: exposure · suit intent · ready-proxy&lt;br&gt;foldFactor = max(0, maxThreat − ownStrength·push)&lt;br&gt;dials default 0 — A/B at 1.4/0.8: did not pay&lt;/font&gt;" vertex="1">
          <mxGeometry height="86" width="290" x="820" y="420" as="geometry" />
        </mxCell>
        <mxCell id="c15" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#dae8fc;strokeColor=#4472a8;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Action → reducer&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;a REQUEST — the table&lt;br&gt;enforces legality + 3-faan floor&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="180" x="1180" y="190" as="geometry" />
        </mxCell>
        <mxCell id="c16" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#333333;" value="&lt;b&gt;What the logic cannot see&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;· &lt;b&gt;chips&lt;/b&gt; — faan valued LINEARLY; the exponential payment table is never consulted (6 faan ≈ 8× chips, bot thinks 2×)&lt;br&gt;· &lt;b&gt;opponents, when picking the route&lt;/b&gt; — threat reaches only discard safety, never plan choice&lt;br&gt;· &lt;b&gt;restructuring when ready-under-floor&lt;/b&gt; — camps instead (10 refusals in one logged hand)&lt;br&gt;· left-feed · claim signaling · discard-order bluffing (STRATEGY.md)&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="470" x="240" y="403" as="geometry" />
        </mxCell>
